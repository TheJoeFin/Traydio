<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    This app's own Last.fm API credentials, used to sign every call to the Last.fm web service
    (see Trdo/Services/Lastfm/LastfmCredentials.cs). They identify Traydio to Last.fm, not any
    individual listener - a user's own Last.fm login happens separately, in the browser, during
    the Connect-to-Last.fm flow.

    To enable Last.fm scrobbling in a local build:
      1. Register a free API account at https://www.last.fm/api/account/create
      2. Copy this file to "OAuth.resw" (same folder) - that file is gitignored, so your
         credentials never get committed.
      3. Replace the two placeholder values below with your API key and shared secret.

    Without a real OAuth.resw, Last.fm scrobbling simply stays unavailable - LastfmCredentials
    logs that it found no file and every Last.fm feature no-ops rather than the app failing to
    build or crashing.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <data name="LastfmApiKey">
    <value>YOUR_LASTFM_API_KEY_HERE</value>
    <comment>32-character API key from your Last.fm API account.</comment>
  </data>
  <data name="LastfmApiSecret">
    <value>YOUR_LASTFM_SHARED_SECRET_HERE</value>
    <comment>Shared secret from the same Last.fm API account. Keep this out of source control.</comment>
  </data>
</root>
