<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Trdo.Controls.CastDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:playback="using:Trdo.Services.Playback"
    x:Uid="CastDeviceDialog"
    Closed="ContentDialog_Closed"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    Opened="ContentDialog_Opened"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    mc:Ignorable="d">

    <!--
        Discovery is owned by the code-behind and only runs between Opened and Closed, so the
        list here is live while the dialog is up and empty (and unsubscribed) once it goes.
    -->
    <StackPanel MinWidth="300" Spacing="12">
        <!--  Shown only while already casting, above the list, so "Stop casting" has context  -->
        <TextBlock
            x:Name="CurrentTargetText"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Search is continuous while open: mDNS answers arrive whenever a device wakes up  -->
        <StackPanel
            x:Name="ScanningRow"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="True" />
            <TextBlock
                x:Uid="CastDeviceDialog_Searching"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView
            x:Name="DeviceList"
            MaxHeight="240"
            DoubleTapped="DeviceList_DoubleTapped"
            SelectionChanged="DeviceList_SelectionChanged"
            SelectionMode="Single"
            Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="playback:CastDevice">
                    <Grid
                        Padding="0,6"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Kind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            x:Uid="CastDeviceDialog_Empty"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="UnavailableText"
            x:Uid="CastDeviceDialog_Unavailable"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
