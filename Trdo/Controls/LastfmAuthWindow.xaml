<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.LastfmAuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traydio"
    Width="380"
    Height="320"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">

        <TitleBar x:Name="ModernTitlebar" x:Uid="LastfmAuth_TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            Grid.Row="1"
            Margin="24,16,24,16"
            VerticalAlignment="Top"
            Spacing="16">

            <TextBlock
                x:Name="StatusTextBlock"
                x:Uid="LastfmAuth_OpeningBrowser"
                TextWrapping="Wrap" />

            <ProgressRing
                x:Name="WorkingProgressRing"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                IsActive="True" />

            <TextBlock
                x:Name="ErrorTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                        <TextBlock x:Uid="Action_Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ContinueButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="ContinueButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE73E;" />
                        <TextBlock x:Uid="LastfmAuth_ContinueButton" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</ex:WindowEx>
