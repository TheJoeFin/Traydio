<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trdo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traydio Mini Player"
    Width="320"
    Height="220"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid
        x:Name="WindowLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowDefinitions="Auto,*"
        Tapped="WindowLayout_Tapped">
        <TitleBar
            x:Name="ModernTitlebar"
            Title="Traydio"
            Subtitle="Mini Player">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid
            Grid.Row="1"
            Margin="8,4,8,8"
            PointerEntered="WindowLayout_PointerEntered"
            PointerExited="WindowLayout_PointerExited">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <ToggleMenuFlyoutItem
                        x:Name="VisualizerToggleMenuItem"
                        Click="VisualizerToggleMenuItem_Click"
                        IsChecked="True"
                        Text="Show Visualizer" />
                    <ToggleMenuFlyoutItem
                        x:Name="TopmostToggleMenuItem"
                        Click="TopmostToggleMenuItem_Click"
                        IsChecked="True"
                        Text="Always on Top" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid MinHeight="104">
                    <Grid
                        x:Name="ActiveContentGrid"
                        Opacity="0"
                        RowDefinitions="Auto,Auto,Auto,*"
                        RowSpacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource OverlayCornerRadius}" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="{x:Bind ViewModel.CurrentAlbumArtPlaceholderGlyph, Mode=OneWay}" />
                                <Border CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Image Source="{x:Bind ViewModel.CurrentAlbumArtImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.MetadataTitleDisplay, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.MetadataArtistDisplay, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{x:Bind ViewModel.MiniPlayerFavoriteButtonText, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="FavoriteTrackButton_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.MiniPlayerFavoriteButtonText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.MiniPlayerFavoriteButtonVisibility, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="{x:Bind ViewModel.MiniPlayerFavoriteButtonGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">
                            <Grid
                                x:Name="ActiveStationIconGrid"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE95A;"
                                    Visibility="{x:Bind ViewModel.SelectedStationFallbackIconVisibility, Mode=OneWay}" />
                                <Border CornerRadius="4">
                                    <Image Source="{x:Bind ViewModel.SelectedStationFaviconImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedStationDisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>

                        <controls:SpectrumVisualizerControl
                            x:Name="SpectrumVisualizer"
                            Grid.Row="3"
                            VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid x:Name="IdleContentGrid" Opacity="0">
                        <Grid
                            x:Name="IdleStationLogoGrid"
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource OverlayCornerRadius}" />
                            <Image
                                Margin="10"
                                Source="ms-appx:///Assets/Radio.png"
                                Stretch="Uniform"
                                Visibility="{x:Bind ViewModel.SelectedStationFallbackIconVisibility, Mode=OneWay}" />
                            <Border CornerRadius="{StaticResource OverlayCornerRadius}">
                                <Image Source="{x:Bind ViewModel.SelectedStationFaviconImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel
                x:Name="HoverControlsOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0"
                Spacing="6"
                Visibility="Visible">
                <Button
                    x:Name="HoverPlayPauseButton"
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.PlaybackButtonText, Mode=OneWay}"
                    Click="PlayPauseButton_Click"
                    CornerRadius="42"
                    IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontSize="34" Glyph="{x:Bind ViewModel.PlaybackButtonGlyph, Mode=OneWay}" />
                </Button>

                <Button
                    x:Name="PauseAndCloseButton"
                    HorizontalAlignment="Center"
                    Click="PauseAndCloseButton_Click"
                    Content="{x:Bind ViewModel.MiniPlayerCloseButtonText, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.MiniPlayerCloseButtonVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
