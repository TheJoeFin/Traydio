<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.ManualStationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traydio"
    Width="400"
    Height="620"
    Closed="WindowEx_Closed"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">


        <TitleBar x:Name="ModernTitlebar" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Content Area  -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16" Spacing="12">

                <!--
                    Hero preview of the station logo. Collapses entirely when there
                    is no usable image, so a station without one loses no space to
                    an empty frame. Uniform keeps non-square logos undistorted.
                -->
                <Border
                    Height="140"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind ViewModel.HasHeroImage, Mode=OneWay}">
                    <Image
                        Margin="12"
                        AutomationProperties.AccessibilityView="Raw"
                        ImageFailed="HeroImage_ImageFailed"
                        Source="{x:Bind ViewModel.HeroImageSource, Mode=OneWay}"
                        Stretch="Uniform" />
                </Border>

                <!--  Station Name Input  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddStation_StationNameLabel" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="StationNameTextBox"
                        x:Uid="AddStation_StationNamePlaceholder"
                        Text="{x:Bind ViewModel.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Stream URL Input  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddStation_StreamUrlLabel" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="StreamUrlTextBox"
                        x:Uid="AddStation_StreamUrlPlaceholder"
                        Text="{x:Bind ViewModel.StreamUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Homepage URL Input  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddStation_HomepageLabel" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="HomepageTextBox"
                        x:Uid="AddStation_HomepagePlaceholder"
                        Text="{x:Bind ViewModel.Homepage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Favicon URL Input  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddStation_LogoUrlLabel" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="FaviconUrlTextBox"
                        x:Uid="AddStation_LogoUrlPlaceholder"
                        Text="{x:Bind ViewModel.FaviconUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Per-station playback settings, collapsed by default  -->
                <Expander
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ManualStationWindow_Advanced" FontWeight="SemiBold" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.BufferSummary, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SongPopupDelaySummary, Mode=OneWay}" />
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Spacing="16">

                        <!--  Per-station volume  -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="ManualStationWindow_Volume" FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="ManualStationWindow_VolumeDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider
                                    Grid.Column="0"
                                    AutomationProperties.Name="Station volume"
                                    Maximum="200"
                                    Minimum="0"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="48"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.VolumeDescription, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <!--  Per-station buffer override  -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="ManualStationWindow_BufferLevel" FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="ManualStationWindow_BufferLevelDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Uid="ManualStationWindow_BufferOverrideToggle"
                                Margin="0,4,0,0"
                                IsOn="{x:Bind ViewModel.HasBufferOverride, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider
                                    Grid.Column="0"
                                    AutomationProperties.Name="Station buffer level"
                                    IsEnabled="{x:Bind ViewModel.HasBufferOverride, Mode=OneWay}"
                                    Maximum="3"
                                    Minimum="0"
                                    SnapsTo="StepValues"
                                    StepFrequency="0.1"
                                    Value="{x:Bind ViewModel.BufferLevel, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="92"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.BufferLevelDescription, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <!--  Per-station track info delay  -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="ManualStationWindow_SongPopupDelay" FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="ManualStationWindow_SongPopupDelayDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Uid="ManualStationWindow_SongPopupDelayOverride"
                                Margin="0,4,0,0"
                                IsOn="{x:Bind ViewModel.HasSongPopupDelayOverride, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider
                                    Grid.Column="0"
                                    AutomationProperties.Name="Station track info delay in seconds"
                                    IsEnabled="{x:Bind ViewModel.HasSongPopupDelayOverride, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.MaxSongPopupDelaySeconds}"
                                    Minimum="0"
                                    SnapsTo="StepValues"
                                    StepFrequency="5"
                                    Value="{x:Bind ViewModel.SongPopupDelaySeconds, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="92"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.SongPopupDelayDescription, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollView>

        <!--  Buttons  -->
        <Border
            Grid.Row="2"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="SaveButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>

</ex:WindowEx>
