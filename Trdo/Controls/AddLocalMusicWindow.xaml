<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.AddLocalMusicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Traydio"
    Width="400"
    Height="420"
    Closed="WindowEx_Closed"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">

        <TitleBar x:Name="ModernTitlebar" Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Content Area  -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16" Spacing="12">

                <!--  Station Name Input  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddLocalMusic_StationNameLabel" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="StationNameTextBox"
                        x:Uid="AddLocalMusic_StationNamePlaceholder"
                        Text="{x:Bind ViewModel.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Folder picker  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddLocalMusic_FolderLabel" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox
                            Grid.Column="0"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.FolderPathDisplay, Mode=OneWay}" />
                        <Button
                            x:Uid="AddLocalMusic_BrowseButton"
                            Grid.Column="1"
                            Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.TrackCountDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Volume  -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="AddLocalMusic_VolumeLabel" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider
                            Grid.Column="0"
                            AutomationProperties.Name="Volume"
                            Maximum="200"
                            Minimum="0"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="48"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.VolumeDescription, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollView>

        <!--  Buttons  -->
        <Border
            Grid.Row="2"
            Padding="24,12,24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                        <TextBlock x:Uid="Action_Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="SaveButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="Action_Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>

</ex:WindowEx>
