<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.ImportExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Trdo.ViewModels"
    Title="Traydio"
    Width="720"
    Height="620"
    MinWidth="520"
    MinHeight="420"
    Closed="WindowEx_Closed"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <TitleBar x:Name="ModernTitlebar" x:Uid="ImportExport_Title">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Direction + actions  -->
        <Grid
            Grid.Row="1"
            Margin="24,8,24,12"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
            <RadioButtons
                x:Name="ModeButtons"
                Grid.Column="0"
                MaxColumns="2"
                SelectionChanged="ModeButtons_SelectionChanged">
                <RadioButton x:Uid="ImportExport_ModeImport" />
                <RadioButton x:Uid="ImportExport_ModeExport" />
            </RadioButtons>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="ImportExport_ChooseFiles"
                    Click="ChooseFilesButton_Click"
                    Visibility="{x:Bind ViewModel.IsImport, Mode=OneWay}" />
                <ComboBox
                    x:Name="FormatComboBox"
                    MinWidth="120"
                    SelectedIndex="0"
                    SelectionChanged="FormatComboBox_SelectionChanged"
                    Visibility="{x:Bind ViewModel.IsExport, Mode=OneWay}">
                    <ComboBoxItem Content="M3U" />
                    <ComboBoxItem Content="PLS" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!--  Preview list; the whole area is the drop target  -->
        <Border
            x:Name="DropZone"
            Grid.Row="2"
            Margin="24,0,24,0"
            AllowDrop="True"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            DragLeave="DropZone_DragLeave"
            DragOver="DropZone_DragOver"
            Drop="DropZone_Drop">
            <Grid>
                <ListView
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportExportItem">
                            <Grid
                                Padding="4,6"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8"
                                Opacity="{x:Bind RowOpacity}">
                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StreamUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind HasDetail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE896;" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalTextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Shown while a drag is over the window  -->
                <Border
                    x:Name="DropOverlay"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Opacity="0.18"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!--  Status + footer  -->
        <StackPanel Grid.Row="3" Margin="24,12,24,16" Spacing="12">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning" />

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button
                    x:Uid="ImportExport_SelectAll"
                    Grid.Column="0"
                    Click="SelectAllButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
                <Button
                    x:Uid="ImportExport_SelectNone"
                    Grid.Column="1"
                    Click="SelectNoneButton_Click"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                <Button Grid.Column="3" Click="CancelButton_Click">
                    <TextBlock x:Uid="Action_Cancel" />
                </Button>
                <Button
                    Grid.Column="4"
                    Click="ConfirmButton_Click"
                    Content="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>

    </Grid>

</ex:WindowEx>
