<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trdo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Trdo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" RowSpacing="24">
        <!--  About Title  -->
        <TextBlock
            x:Uid="AboutPage_Title"
            Grid.Row="0"
            FontSize="24"
            FontWeight="SemiBold" />

        <!--  About Content  -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,12,0" Spacing="24">
                <!--  App Name and Version  -->
                <Grid
                    HorizontalAlignment="Center"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.RowSpan="2"
                        Height="60"
                        Source="/Assets/Radio.png" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextAlignment="Left"
                        TextWrapping="Wrap">
                        <Run>Traydio</Run><LineBreak />
                        <Run x:Uid="AboutPage_Formerly" FontSize="14" FontWeight="Light" />
                    </TextBlock>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Version}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  Description  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppDescription}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Review Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_EnjoyingPrompt"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="AboutPage_RateLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!--  Star Rating  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="Star1"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Star_Click"
                            Tag="1">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />
                        </Button>
                        <Button
                            x:Name="Star2"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Star_Click"
                            Tag="2">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />
                        </Button>
                        <Button
                            x:Name="Star3"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Star_Click"
                            Tag="3">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />
                        </Button>
                        <Button
                            x:Name="Star4"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Star_Click"
                            Tag="4">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />
                        </Button>
                        <Button
                            x:Name="Star5"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Star_Click"
                            Tag="5">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />
                        </Button>
                    </StackPanel>

                    <!--  Contact Developer Section (shown for 3 or fewer stars)  -->
                    <TextBlock
                        x:Uid="AboutPage_IssuePrompt"
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowContactDeveloper,
                                            Mode=OneWay}" />

                    <Button
                        x:Name="ContactDeveloperButton"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ContactDeveloperButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowContactDeveloper,
                                            Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE715;" />
                            <TextBlock x:Uid="AboutPage_ContactDeveloper" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Buy Me a Coffee Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_SupportTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="AboutPage_SupportBody"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton Margin="0,8,0,0" Click="BuyMeACoffeeButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:CoffeeCupIcon />
                            <TextBlock Text="{x:Bind ViewModel.BuyMeACoffeeDisplayText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!--  GitHub Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_OpenSourceTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="AboutPage_OpenSourceBody"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton
                        Margin="0,8,0,0"
                        Click="GitHubButton_Click"
                        Content="{x:Bind ViewModel.GitHubDisplayText}" />
                </StackPanel>

                <!--  Developer Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_DeveloperTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.DeveloperName}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton Margin="0,8,0,0" Click="DeveloperGitHubButton_Click">
                        <TextBlock x:Uid="AboutPage_VisitDeveloperGitHub" TextWrapping="Wrap" />
                    </HyperlinkButton>
                </StackPanel>

                <!--  Features Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_FeaturesTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Uid="AboutPage_Feature_SystemTray"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Uid="AboutPage_Feature_MultiStations"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Uid="AboutPage_Feature_Watchdog"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Uid="AboutPage_Feature_StartWithWindows"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!--  Radio Browser Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_RadioDatabaseTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RadioBrowserDescription}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton Margin="0,8,0,0" Click="RadioBrowserButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                            <TextBlock Text="{x:Bind ViewModel.RadioBrowserDisplayText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!--  Open Source Libraries Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_BuiltWithOpenSourceTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="AboutPage_BuiltWithOpenSourceBody"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <HyperlinkButton Padding="0,4" Click="WinUIExButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                <TextBlock Text="{x:Bind ViewModel.WinUIExDisplayText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton Padding="0,4" Click="CommunityToolkitButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                <TextBlock Text="{x:Bind ViewModel.CommunityToolkitDisplayText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>

                    <!--  Sonos casting owes its approach to RoomRelay; credit where it is due  -->
                    <TextBlock
                        x:Uid="AboutPage_SonosAcknowledgement"
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <HyperlinkButton Padding="0,4" Click="RoomRelayButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE774;" />
                            <TextBlock Text="{x:Bind ViewModel.RoomRelayDisplayText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!--  Tutorial Section  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="AboutPage_HelpTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Uid="AboutPage_HelpBody"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="TutorialButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                            <TextBlock x:Uid="AboutPage_ViewTutorial" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
