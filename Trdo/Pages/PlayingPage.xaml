<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.PlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:Trdo.Controls"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI.MarqueeTextRns"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CountToEmptyStateVisibilityConverter x:Key="CountToEmptyStateVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:PercentStringConverter x:Key="PercentStringConverter" />

        <!--
            Station row. Column 0 holds the indentation rail, which collapses to zero width for
            a station that is not in a folder - so an ungrouped list renders exactly as it did
            before folders existed.
        -->
        <DataTemplate x:Key="StationRowTemplate" x:DataType="models:RadioStation">
            <!--
                Background="Transparent" so the row is hit-testable across its empty stretches
                too - otherwise hovering anywhere that is not already covered by the favicon or
                the name text would never raise PointerEntered/Exited, and the chevron would
                only ever appear over those two spots.
            -->
            <Grid
                Background="Transparent"
                ColumnDefinitions="Auto,Auto,*,Auto"
                PointerEntered="StationRow_PointerEntered"
                PointerExited="StationRow_PointerExited">
                <Grid.ContextFlyout>
                    <!--
                        The three original commands stay first and in their original order:
                        this menu has been the same since 1.x and muscle memory is worth more
                        than a tidier grouping.
                    -->
                    <MenuFlyout Opening="StationContextMenu_Opening">
                        <!--
                            Text and icon are rewritten in StationContextMenu_Opening for a
                            local album - "Visit Website" makes no sense for one, and containers
                            get recycled as the list scrolls, so the row-specific wording cannot
                            just be set once here.
                        -->
                        <MenuFlyoutItem
                            x:Name="VisitWebsiteMenuItem"
                            x:Uid="PlayingPage_VisitWebsite"
                            Click="VisitSite_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB41;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_Edit"
                            Click="EditStation_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_Remove"
                            Click="RemoveStation_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="MoveToGroupSubItem" x:Uid="PlayingPage_MoveToGroup">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8DE;" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_InsertDividerAbove"
                            Click="InsertDividerAbove_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE738;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_RefreshStationInfo"
                            Click="RefreshStationInfo_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <!--  Selection indicator  -->
                <Border
                    x:Name="SelectionIndicator"
                    Grid.ColumnSpan="4"
                    Margin="-8,-6"
                    Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="2"
                    Visibility="{x:Bind IsSelectedStation, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <!--  Indentation rail, shown only for a station inside a folder  -->
                <Border
                    Grid.Column="0"
                    Width="1"
                    Margin="6,0,10,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind GroupId, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" />

                <!--  Favicon - falls back to a placeholder icon per SourceKind when there's no cover art  -->
                <Grid
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="{x:Bind FaviconPlaceholderGlyph, Mode=OneWay}"
                        Visibility="{x:Bind ShowsFaviconPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <Border CornerRadius="4">
                        <Image Source="{x:Bind FaviconUrl, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <!--  Station Name  -->
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!--
                    View album tracks - a local album only, since that is the only row kind
                    with a track list behind it. Hidden until the row is hovered; see
                    StationRow_PointerEntered/Exited.
                -->
                <Button
                    x:Name="ViewAlbumTracksButton"
                    x:Uid="PlayingPage_ViewAlbumTracks"
                    Grid.Column="3"
                    Padding="6"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ViewAlbumTracks_Click"
                    Opacity="0"
                    Tag="{x:Bind}"
                    Visibility="{x:Bind IsLocalAlbum, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  Folder header. Tapping anywhere on the row expands or collapses it.  -->
        <DataTemplate x:Key="StationGroupRowTemplate" x:DataType="models:StationGroup">
            <Grid
                Background="Transparent"
                ColumnDefinitions="Auto,*,Auto"
                ContextRequested="GroupRow_ContextRequested"
                Tapped="GroupRow_Tapped">
                <!--
                    Renaming or deleting a folder only makes sense for one the user created.
                    GroupRow_ContextRequested swallows this entirely for a synthetic "Group by"
                    folder, since there is nothing here for it to do.
                -->
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_Rename"
                            Click="RenameGroup_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!--
                            Removing the folder keeps the stations, so it needs no confirming -
                            same reasoning as removing a single station. Throwing the stations
                            away is a separate, explicitly worded command that does confirm.
                        -->
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_DeleteGroup"
                            Click="DeleteGroup_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_DeleteGroupAndStations"
                            Click="DeleteGroupAndStations_Click"
                            Tag="{x:Bind}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <FontIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind StationCount, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!--  Divider: a rule, with the caption inline when there is one.  -->
        <DataTemplate x:Key="StationDividerRowTemplate" x:DataType="models:StationDivider">
            <Grid
                Background="Transparent"
                ColumnDefinitions="Auto,Auto,*"
                Tapped="DividerRow_Tapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_EditLabel"
                            Click="EditDividerLabel_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_RemoveDivider"
                            Click="RemoveDivider_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Border
                    Grid.Column="0"
                    Width="1"
                    Margin="6,0,10,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind GroupId, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Label, Mode=OneWay}"
                    Visibility="{x:Bind HasLabel, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <Border
                    Grid.Column="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </DataTemplate>

        <controls:StationRowTemplateSelector
            x:Key="StationRowTemplateSelector"
            DividerTemplate="{StaticResource StationDividerRowTemplate}"
            GroupTemplate="{StaticResource StationGroupRowTemplate}"
            StationTemplate="{StaticResource StationRowTemplate}" />

        <Style x:Key="StationRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="StationGroupRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="StationDividerRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <controls:StationRowContainerStyleSelector
            x:Key="StationRowContainerStyleSelector"
            DividerStyle="{StaticResource StationDividerRowContainerStyle}"
            GroupStyle="{StaticResource StationGroupRowContainerStyle}"
            StationStyle="{StaticResource StationRowContainerStyle}" />
    </Page.Resources>

    <!--
        Background="Transparent" so empty stretches of the grid (the Stations header, the
        space left when the volume slider is hidden) are hit-testable - a Grid with no
        background lets pointer input fall through it instead of reaching ContextFlyout below.
        
        Row spacing is applied per-row via Margin rather than Grid.RowSpacing: RowSpacing adds
        its gap on both sides of a row even when that row's content is Collapsed, which is what
        left a phantom gap above the playback buttons whenever the volume slider was hidden.
    -->
    <Grid Background="Transparent" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="PageContextMenu" Opening="PageContextMenu_Opening">
                <MenuFlyoutItem
                    x:Name="NewGroupMenuItem"
                    x:Uid="PlayingPage_NewGroup"
                    Click="NewGroup_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Name="NewDividerMenuItem"
                    x:Uid="PlayingPage_NewDivider"
                    Click="NewDivider_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE738;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="SortBySubItem" x:Uid="PlayingPage_SortBy">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="GroupBySubItem" x:Uid="PlayingPage_GroupBy">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xF168;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="RefreshAllInfoMenuItem"
                    x:Uid="PlayingPage_RefreshAllInfo"
                    Click="RefreshAllStationInfo_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ShowVolumeMenuItem"
                    x:Uid="PlayingPage_ShowVolume"
                    Click="ToggleVolumeSlider_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Add Station Button  -->
            <Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Click="AddStationButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock x:Uid="PlayingPage_StationButton" />
                </StackPanel>
            </Button>

            <!--  Favorites Icon Button (Subtle)  -->
            <Button
                x:Uid="PlayingPage_Favorites"
                Grid.Column="2"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="FavoritesButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE728;" />
            </Button>

            <!--  Info Icon Button (Subtle)  -->
            <Button
                x:Uid="PlayingPage_About"
                Grid.Column="3"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="InfoButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE946;" />
            </Button>

            <!--  Settings Icon Button (Subtle)  -->
            <Button
                x:Uid="PlayingPage_Settings"
                Grid.Column="4"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="SettingsButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Stations Header  -->
        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnDefinitions="Auto,*">
            <TextBlock
                x:Uid="PlayingPage_StationsHeader"
                Grid.Column="0"
                FontSize="16"
                FontWeight="SemiBold" />

            <!--
                Only shown while a view sort or a view grouping is active. Names all the
                surprises at once - folders hidden or replaced, dividers hidden, dragging off -
                because meeting them one at a time reads like a bug.
            -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                Orientation="Horizontal"
                Spacing="2"
                Visibility="{x:Bind ViewModel.IsViewArrangementActive, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ViewArrangementHintText, Mode=OneWay}" />
                <HyperlinkButton
                    x:Uid="PlayingPage_Manual"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Click="ResetSort_Click"
                    FontSize="11" />
            </StackPanel>
        </Grid>

        <!--  Stations List  -->
        <Grid
            Grid.Row="2"
            Margin="0,12,0,0"
            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}">
            <ListView
                x:Name="StationsListView"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="StationsListView_DragItemsCompleted"
                DragItemsStarting="StationsListView_DragItemsStarting"
                ItemContainerStyleSelector="{StaticResource StationRowContainerStyleSelector}"
                ItemTemplateSelector="{StaticResource StationRowTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.DisplayRows, Mode=OneWay}"
                SelectionChanged="StationsListView_SelectionChanged"
                SelectionMode="Single" />

            <!--  Empty State  -->
            <Grid
                x:Name="EmptyStatePanel"
                Padding="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                Visibility="{x:Bind ViewModel.StationCount, Mode=OneWay, Converter={StaticResource CountToEmptyStateVisibilityConverter}}">
                <StackPanel
                    MaxWidth="240"
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <!--  Radio Icon  -->
                    <Viewbox
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center">
                        <FontIcon
                            FontSize="80"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE95A;" />
                    </Viewbox>

                    <!--  Welcome Message  -->
                    <TextBlock
                        x:Uid="PlayingPage_EmptyTitle"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextAlignment="Center" />

                    <!--  Description  -->
                    <TextBlock
                        x:Uid="PlayingPage_EmptySubtitle"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!--  Add Station Button  -->
                    <Button
                        HorizontalAlignment="Center"
                        Click="AddStationButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock x:Uid="PlayingPage_AddFirstStation" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Volume Control  -->
        <Grid
            x:Name="VolumeControlGrid"
            Grid.Row="3"
            Margin="0,12,0,0"
            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}"
            animations:Implicit.HideAnimations="{StaticResource ImplicitFadeHideAnimations}"
            animations:Implicit.ShowAnimations="{StaticResource ImplicitFadeShowAnimations}"
            Background="Transparent"
            ColumnSpacing="8"
            PointerWheelChanged="VolumeControl_PointerWheelChanged">
            <!--
                No ContextFlyout of its own: a right-click here falls through to the page's
                menu on Grid.ContextFlyout above, which already carries a Show/Hide Volume
                Slider item alongside the folder and divider commands.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="&#xE767;" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                Maximum="200"
                Minimum="0"
                SmallChange="1"
                StepFrequency="1"
                ThumbToolTipValueConverter="{StaticResource PercentStringConverter}"
                Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="40"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.VolumePercent, Mode=OneWay, Converter={StaticResource PercentStringConverter}}"
                TextAlignment="Right" />
        </Grid>

        <!--  Now Playing Info  -->
        <Button
            x:Name="NowPlayingButton"
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="8,4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}"
            animations:Implicit.HideAnimations="{StaticResource ImplicitFadeHideAnimations}"
            animations:Implicit.ShowAnimations="{StaticResource ImplicitFadeShowAnimations}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="0"
            Click="NowPlayingInfo_Click"
            CornerRadius="4"
            ToolTipService.ToolTip="Click for details"
            Visibility="{x:Bind ViewModel.HasNowPlaying, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        animations:Connected.Key="NowPlayingTrackIcon"
                        FontSize="14"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="{x:Bind ViewModel.CurrentAlbumArtPlaceholderGlyph, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CurrentAlbumArtPlaceholderVisibility, Mode=OneWay}" />
                    <Border CornerRadius="2">
                        <Image Source="{x:Bind ViewModel.CurrentAlbumArtImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <Grid
                    x:Name="NowPlayingTextHost"
                    Grid.Column="1"
                    SizeChanged="NowPlayingTextHost_SizeChanged">
                    <labs:MarqueeText
                        x:Name="NowPlayingMarqueeText"
                        VerticalAlignment="Center"
                        animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                        animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                        Behavior="Looping"
                        Direction="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        RepeatBehavior="1x"
                        Speed="40"
                        Text="{x:Bind ViewModel.NowPlaying, Mode=OneWay}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="NowPlayingText"
                        VerticalAlignment="Center"
                        animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                        animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.NowPlaying, Mode=OneWay}"
                        TextTrimming="Clip"
                        TextWrapping="NoWrap" />
                </Grid>
                <!--  Favorite Button  -->
                <Button
                    x:Name="FavoriteButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FavoriteButton_Click"
                    ToolTipService.ToolTip="Favorite Song">
                    <FontIcon
                        x:Name="FavoriteIcon"
                        FontSize="14"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE734;" />
                </Button>
                <FontIcon
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </Button>

        <!--  Local Music Scrub Bar  -->
        <Grid
            Grid.Row="5"
            Margin="0,12,0,0"
            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}"
            ColumnSpacing="4"
            Visibility="{x:Bind ViewModel.IsLocalMusicActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PreviousTrackButton"
                Grid.Column="0"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="PreviousTrackButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoToPreviousLocalTrack, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE892;" />
            </Button>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}" />

            <Slider
                x:Name="SeekSlider"
                Grid.Column="2"
                Maximum="100"
                Minimum="0"
                PointerCaptureLost="SeekSlider_PointerCaptureLost"
                PointerPressed="SeekSlider_PointerPressed"
                Value="{x:Bind ViewModel.SeekProgress, Mode=TwoWay}" />

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" />
            <Button
                x:Name="NextTrackButton"
                Grid.Column="4"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="NextTrackButton_Click"
                IsEnabled="{x:Bind ViewModel.CanGoToNextLocalTrack, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE893;" />
            </Button>
        </Grid>

        <!--  Playback Actions  -->
        <Grid
            Grid.Row="6"
            Margin="0,12,0,0"
            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PlayButton"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="PlayButton_Click"
                IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PlaybackButtonGlyph, Mode=OneWay}" />
                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.PlaybackButtonText, Mode=OneWay}" />
                </StackPanel>
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <!--  Disabled item used as a plain label rather than a real command.  -->
                        <MenuFlyoutItem x:Uid="PlayingPage_SleepTimer" IsEnabled="False" />
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_SleepTimer15Minutes"
                            Click="SleepTimerMenuItem_Click"
                            Tag="15" />
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_SleepTimer20Minutes"
                            Click="SleepTimerMenuItem_Click"
                            Tag="20" />
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_SleepTimer30Minutes"
                            Click="SleepTimerMenuItem_Click"
                            Tag="30" />
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_SleepTimer45Minutes"
                            Click="SleepTimerMenuItem_Click"
                            Tag="45" />
                        <MenuFlyoutItem
                            x:Uid="PlayingPage_SleepTimer50Minutes"
                            Click="SleepTimerMenuItem_Click"
                            Tag="50" />
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>

            <!--
                Sleep timer countdown. Only takes a column when active, at which point it
                squeezes in between the play/pause button and the pop-out link - PlayButton's
                column is "*" so the space it gives up comes straight out of that button rather
                than the two HyperlinkButtons after it.
            -->
            <Button
                x:Name="SleepTimerButton"
                x:Uid="PlayingPage_CancelSleepTimer"
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="SleepTimerButton_Click"
                CornerRadius="16"
                PointerEntered="SleepTimerButton_PointerEntered"
                PointerExited="SleepTimerButton_PointerExited"
                Visibility="{x:Bind ViewModel.IsSleepTimerActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Width="28" Height="28">
                    <Grid x:Name="SleepTimerRingHost">
                        <Ellipse
                            Width="28"
                            Height="28"
                            Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                            StrokeThickness="2.5" />
                        <Ellipse
                            x:Name="SleepTimerRingProgress"
                            Width="28"
                            Height="28"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="8.5"
                            Text="{x:Bind ViewModel.SleepTimerDisplayText, Mode=OneWay}" />
                    </Grid>
                    <FontIcon
                        x:Name="SleepTimerCancelIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE711;"
                        Opacity="0" />
                </Grid>
            </Button>

            <HyperlinkButton
                x:Uid="PlayingPage_PopOutButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="PopOutButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="16" Glyph="&#xE93A;" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton
                x:Uid="PlayingPage_QuitButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Page>
