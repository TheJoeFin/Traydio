<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <!--
                So a card that shows or hides conditionally (e.g. the silence-timeout card, gated
                on IsWatchdogEnabled) fades in/out instead of popping, and every other card in the
                StackPanel glides to its new position instead of snapping when that happens.
            -->
            <Setter Property="animations:Implicit.Animations" Value="{StaticResource ImplicitReflowAnimations}" />
            <Setter Property="animations:Implicit.HideAnimations" Value="{StaticResource ImplicitFadeHideAnimations}" />
            <Setter Property="animations:Implicit.ShowAnimations" Value="{StaticResource ImplicitFadeShowAnimations}" />
        </Style>
        <Style x:Key="NestedSettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="24">
        <!--  Settings Title  -->
        <TextBlock
            x:Uid="SettingsPage_Title"
            Grid.Row="0"
            FontSize="24"
            FontWeight="SemiBold" />

        <!--  Settings Content  -->
        <ScrollView Grid.Row="1">
            <StackPanel Padding="0,0,8,8" Spacing="12">
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_LanguageTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_LanguageDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.LanguageSelectionIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_Language_System" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_English" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_Spanish" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_French" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_Chinese" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_German" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_PortugueseBrazil" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_PortuguesePortugal" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_Arabic" />
                            <ComboBoxItem x:Uid="SettingsPage_Language_Polish" />
                        </ComboBox>
                        <InfoBar
                            x:Uid="SettingsPage_RestartRequiredInfoBar"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsLanguageRestartPending, Mode=OneWay}"
                            Severity="Informational" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_OpenOnStartupTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_OpenOnStartupDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsEnabled="{x:Bind ViewModel.IsStartupToggleEnabled,
                                                   Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsStartupEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.StartupToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_PlayOnStartupTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_PlayOnStartupDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <InfoBar
                            x:Name="AutoPlayWarningInfoBar"
                            x:Uid="SettingsPage_AutoPlayWarning"
                            Margin="-12"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Warning">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="ConfirmAutoPlayButton"
                                    x:Uid="SettingsPage_Enable"
                                    Click="ConfirmAutoPlayButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AutoPlayOnStartupToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsAutoPlayOnStartupEnabled,
                                              Mode=OneWay}"
                                OffContent=""
                                OnContent=""
                                Toggled="AutoPlayOnStartupToggle_Toggled" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AutoPlayOnStartupToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_TrayClickBehaviorTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock
                            x:Uid="SettingsPage_TrayClickBehaviorDescription"
                            Style="{StaticResource SettingDescriptionStyle}"
                            TextWrapping="Wrap" />
                        <!--
                            Items follow the TrayClickAction enum order; the view model maps
                            index to value directly.
                        -->
                        <ComboBox
                            x:Uid="SettingsPage_TrayLeftClick"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.TrayLeftClickActionIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_None" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_PlayPause" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowFlyout" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_MuteUnmute" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_FavoriteTrack" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowTrackInfo" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ToggleMiniPlayer" />
                        </ComboBox>
                        <ComboBox
                            x:Uid="SettingsPage_TrayRightClick"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.TrayRightClickActionIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_None" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_PlayPause" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowFlyout" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_MuteUnmute" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_FavoriteTrack" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowTrackInfo" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ToggleMiniPlayer" />
                        </ComboBox>
                        <ComboBox
                            x:Uid="SettingsPage_TrayLeftDoubleClick"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.TrayLeftDoubleClickActionIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_None" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_PlayPause" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowFlyout" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_MuteUnmute" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_FavoriteTrack" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowTrackInfo" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ToggleMiniPlayer" />
                        </ComboBox>
                        <ComboBox
                            x:Uid="SettingsPage_TrayRightDoubleClick"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.TrayRightDoubleClickActionIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_None" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_PlayPause" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowFlyout" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_MuteUnmute" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_FavoriteTrack" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ShowTrackInfo" />
                            <ComboBoxItem x:Uid="SettingsPage_TrayClickAction_ToggleMiniPlayer" />
                        </ComboBox>
                        <TextBlock
                            x:Uid="SettingsPage_TrayDoubleClickNote"
                            Style="{StaticResource SettingDescriptionStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_TrackInfoDelayTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock
                            x:Uid="SettingsPage_SongPopupDelayExplanation"
                            Style="{StaticResource SettingDescriptionStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider
                                x:Uid="SettingsPage_SongPopupDelaySlider"
                                Grid.Column="0"
                                Maximum="{x:Bind ViewModel.MaxTrackInfoDelaySeconds}"
                                Minimum="0"
                                SnapsTo="StepValues"
                                StepFrequency="5"
                                Value="{x:Bind ViewModel.TrackInfoDelaySeconds, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.TrackInfoDelayDescription, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_SongChangePopupTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_SongChangePopupDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="SongChangePopupToggle"
                                x:Uid="SettingsPage_SongChangePopupToggle"
                                AutomationProperties.AutomationId="SongChangePopupToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsSongChangePopupEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.SongChangePopupToggleText, Mode=OneWay}" />
                            <Button
                                x:Name="SongChangePopupDemoButton"
                                x:Uid="SettingsPage_DemoPopupButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="SongChangePopupDemoButton"
                                Click="SongChangePopupDemoButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Uid="SettingsPage_PopupDwellExplanation"
                            Style="{StaticResource SettingDescriptionStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider
                                x:Uid="SettingsPage_PopupDwellSlider"
                                Grid.Column="0"
                                IsEnabled="{x:Bind ViewModel.IsSongChangePopupEnabled, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.MaxSongChangePopupDwellSeconds}"
                                Minimum="{x:Bind ViewModel.MinSongChangePopupDwellSeconds}"
                                SnapsTo="StepValues"
                                StepFrequency="0.5"
                                Value="{x:Bind ViewModel.SongChangePopupDwellSeconds, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.SongChangePopupDwellDescription, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_MusicSearchServicesTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_MusicSearchServicesDescription" Style="{StaticResource SettingDescriptionStyle}" />

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/spotify.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Spotify"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsSpotifyEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/discogs.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Discogs"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsDiscogsEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/apple_music.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Apple Music"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsAppleMusicEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/ytmusic.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="YouTube Music"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsYouTubeMusicEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/bandcamp.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Bandcamp"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsBandcampEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/qobuz.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Qobuz"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsQobuzEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}" Visibility="{x:Bind ViewModel.IsLastfmAvailable}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/LastFM.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                x:Uid="SettingsPage_LastfmTitle"
                                Style="{StaticResource SettingTitleStyle}" />
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsOn="{x:Bind ViewModel.IsLastfmScrobblingEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <TextBlock x:Uid="SettingsPage_LastfmDescription" Style="{StaticResource SettingDescriptionStyle}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.LastfmConnectionStatusText, Mode=OneWay}" />
                            <Button
                                x:Name="LastfmConnectButton"
                                x:Uid="SettingsPage_LastfmConnectButton"
                                Grid.Column="1"
                                Click="LastfmConnectButton_Click"
                                Visibility="{x:Bind ViewModel.IsLastfmNotConnected, Mode=OneWay}" />
                            <Button
                                x:Name="LastfmDisconnectButton"
                                x:Uid="SettingsPage_LastfmDisconnectButton"
                                Grid.Column="2"
                                Click="LastfmDisconnectButton_Click"
                                Visibility="{x:Bind ViewModel.IsLastfmConnected, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_PlaybackEngineTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_PlaybackEngineDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.PlaybackEngineModeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="SettingsPage_PlaybackEngine_Auto" />
                            <ComboBoxItem x:Uid="SettingsPage_PlaybackEngine_NativeOnly" />
                            <ComboBoxItem x:Uid="SettingsPage_PlaybackEngine_NativePreferred" />
                        </ComboBox>
                        <TextBlock
                            Style="{StaticResource SettingStatusStyle}"
                            Text="{x:Bind ViewModel.PlaybackEngineModeDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="SettingsPage_PlaybackEngine_RememberedInfo"
                            Style="{StaticResource SettingDescriptionStyle}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ResetEngineMemoryButton"
                            x:Uid="SettingsPage_ResetRememberedEngines"
                            Click="ResetEngineMemoryButton_Click" />
                        <InfoBar
                            x:Name="EngineMemoryInfoBar"
                            IsClosable="True"
                            IsOpen="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_AutoRecoverTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_AutoRecoverDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="WatchdogToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsWatchdogEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.WatchdogToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}" Visibility="{x:Bind ViewModel.IsWatchdogEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_SilenceTimeoutTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_SilenceTimeoutDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Slider
                                x:Name="SilenceTimeoutSlider"
                                Grid.Column="0"
                                Maximum="30"
                                Minimum="1"
                                SnapsTo="StepValues"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.SilenceTimeoutSeconds,
                                               Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="36"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.SilenceTimeoutDisplay,
                                              Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="2"
                                Height="18"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Rectangle
                                    x:Name="Bar1"
                                    Width="3"
                                    Height="4"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar2"
                                    Width="3"
                                    Height="7"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar3"
                                    Width="3"
                                    Height="10"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar4"
                                    Width="3"
                                    Height="13"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar5"
                                    Width="3"
                                    Height="18"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_AutoIncreaseBufferTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_AutoIncreaseBufferDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AutoBufferToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsAutoBufferIncreaseEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AutoBufferToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_BufferLevelTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_BufferLevelDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider
                                x:Name="BufferLevelSlider"
                                Grid.Column="0"
                                Maximum="3"
                                Minimum="0"
                                SnapsTo="StepValues"
                                StepFrequency="0.1"
                                Value="{x:Bind ViewModel.BufferLevel,
                                               Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="92"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.BufferLevelDescription,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_RadioStaticTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_RadioStaticDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="RadioStaticToggle"
                                x:Uid="SettingsPage_RadioStaticToggle"
                                AutomationProperties.AutomationId="RadioStaticToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsRadioStaticEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.RadioStaticToggleText, Mode=OneWay}" />
                            <Button
                                x:Name="RadioStaticTestButton"
                                x:Uid="SettingsPage_RadioStaticTestButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RadioStaticTestButton"
                                Click="RadioStaticTestButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_AllowSleepTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_AllowSleepDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AllowSleepToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.AllowSleepWhilePlaying,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AllowSleepToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_ImportExportTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_ImportExportDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button
                                x:Name="ImportButton"
                                x:Uid="SettingsPage_ImportStations"
                                Click="ImportButton_Click" />
                            <Button
                                x:Name="ExportButton"
                                x:Uid="SettingsPage_ExportStations"
                                Click="ExportButton_Click" />
                        </StackPanel>
                        <InfoBar
                            x:Name="ImportExportInfoBar"
                            IsClosable="True"
                            IsOpen="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="SettingsPage_DiagnosticsTitle" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock x:Uid="SettingsPage_DiagnosticsDescription" Style="{StaticResource SettingDescriptionStyle}" />
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button
                                x:Name="OpenLogsFolderButton"
                                x:Uid="SettingsPage_OpenLogsFolder"
                                Click="OpenLogsFolderButton_Click" />
                            <Button
                                x:Name="CopyDiagnosticsButton"
                                x:Uid="SettingsPage_CopyDiagnostics"
                                Click="CopyDiagnosticsButton_Click" />
                            <Button
                                x:Name="ResetLogsButton"
                                x:Uid="SettingsPage_ResetLogs"
                                Click="ResetLogsButton_Click" />
                        </StackPanel>
                        <InfoBar
                            x:Name="DiagnosticsInfoBar"
                            IsClosable="True"
                            IsOpen="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
