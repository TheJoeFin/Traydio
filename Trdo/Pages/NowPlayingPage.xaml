<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    xmlns:vm="using:Trdo.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CountToHasItemsVisibilityConverter x:Key="CountToHasItemsVisibilityConverter" />
        <converters:BooleanToFavoriteGlyphConverter x:Key="BooleanToFavoriteGlyphConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <!--  Page Title  -->
        <TextBlock
            x:Uid="NowPlayingPage_Title"
            Grid.Row="0"
            FontSize="16"
            FontWeight="SemiBold" />

        <!--  Current Track Card  -->
        <Grid Grid.Row="1" Padding="0,0,0,0">

            <!--  Idle Message  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsPlaybackActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    x:Uid="NowPlayingPage_IdleTitle"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="NowPlayingPage_IdleSubtitle"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Track Info Display  -->
            <Grid
                VerticalAlignment="Top"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                Visibility="{x:Bind ViewModel.IsPlaybackActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <!--  Music Icon and Track Info  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                x:Name="TrackIcon"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                animations:Connected.Key="NowPlayingTrackIcon"
                                FontSize="24"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8D6;" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                animations:Connected.AnchorElement="{x:Bind TrackIcon}"
                                Spacing="4">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="NowPlayingPage_Label_Title"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.TitleDisplay, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Uid="NowPlayingPage_Label_Artist"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.ArtistDisplay, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Favorite Button  -->
                            <Button
                                x:Uid="NowPlayingPage_Tooltip_Favorite"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="8"
                                VerticalAlignment="Center"
                                animations:Connected.AnchorElement="{x:Bind TrackIcon}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FavoriteCurrentTrack_Click">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="{x:Bind ViewModel.IsCurrentTrackFavorited, Mode=OneWay, Converter={StaticResource BooleanToFavoriteGlyphConverter}}" />
                            </Button>
                        </Grid>

                        <!--  Search Links  -->
                        <Grid
                            Margin="36,4,0,0"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            Visibility="{x:Bind ViewModel.HasEnabledMusicServices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border
                                Grid.Column="0"
                                Padding="4,0"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="8">

                                        <!--  Search on Spotify  -->
                                        <HyperlinkButton
                                            Padding="6,4"
                                            Click="SpotifyLink_Click"
                                            Visibility="{x:Bind ViewModel.IsSpotifyEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/spotify.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock FontSize="11" Text="Spotify" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <!--  Search on Discogs  -->
                                        <HyperlinkButton
                                            Padding="6,4"
                                            Click="DiscogsLink_Click"
                                            Visibility="{x:Bind ViewModel.IsDiscogsEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/discogs.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock FontSize="11" Text="Discogs" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <!--  Search on Apple Music  -->
                                        <HyperlinkButton
                                            Padding="6,4"
                                            Click="AppleMusicLink_Click"
                                            Visibility="{x:Bind ViewModel.IsAppleMusicEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/apple_music.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock FontSize="11" Text="Apple Music" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <!--  Search on YouTube Music  -->
                                        <HyperlinkButton
                                            Padding="6,4"
                                            Click="YouTubeMusicLink_Click"
                                            Visibility="{x:Bind ViewModel.IsYouTubeMusicEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/ytmusic.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock FontSize="11" Text="YouTube Music" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <!--  Search on Bandcamp  -->
                                        <HyperlinkButton
                                            Padding="6,4"
                                            Click="BandcampLink_Click"
                                            Visibility="{x:Bind ViewModel.IsBandcampEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/bandcamp.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock FontSize="11" Text="Bandcamp" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Button
                                x:Uid="NowPlayingPage_Tooltip_SearchSettings"
                                Grid.Column="1"
                                Padding="8"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SettingsButton_Click"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <FontIcon FontSize="14" Glyph="&#xE713;" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--  Playlist History Section - hidden for local music, which shows its folder's track list instead  -->
        <Grid
            Grid.Row="2"
            Padding="0,0,0,0"
            Visibility="{x:Bind ViewModel.IsLocalMusicActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  History Header  -->
            <TextBlock
                x:Uid="NowPlayingPage_RecentTracks"
                Grid.Row="0"
                Margin="0,0,0,8"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.PlaylistHistory.Count, Mode=OneWay, Converter={StaticResource CountToHasItemsVisibilityConverter}}" />

            <!--  History List  -->
            <ListView
                Grid.Row="1"
                Padding="0,0,12,0"
                animations:Implicit.HideAnimations="{StaticResource ImplicitCrossFadeHideAnimations}"
                animations:Implicit.ShowAnimations="{StaticResource ImplicitCrossFadeShowAnimations}"
                ItemsSource="{x:Bind ViewModel.PlaylistHistory, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.PlaylistHistory.Count, Mode=OneWay, Converter={StaticResource CountToHasItemsVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistHistoryItem">
                        <Grid
                            Padding="10"
                            animations:Implicit.Animations="{StaticResource ImplicitReflowAnimations}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Track Info  -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Bind DisplayText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind StationName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="•" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind FormattedTime}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Favorite Toggle Button  -->
                            <Button
                                Grid.Column="2"
                                Padding="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FavoriteHistoryItem_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Favorite Song">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="{x:Bind IsFavorited, Mode=OneWay, Converter={StaticResource BooleanToFavoriteGlyphConverter}}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Local Music Track List Section  -->
        <Grid
            Grid.Row="2"
            Padding="0,0,0,0"
            Visibility="{x:Bind ViewModel.IsLocalMusicActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Uid="NowPlayingPage_TrackList"
                Grid.Row="0"
                Margin="0,0,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ListView
                Grid.Row="1"
                Padding="0,0,12,0"
                ItemsSource="{x:Bind ViewModel.LocalTrackList, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.CurrentLocalTrackIndex, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.Resources>
                    <StaticResource
                        x:Key="ListViewItemBackgroundSelected"
                        ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource
                        x:Key="ListViewItemBackgroundSelectedPointerOver"
                        ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource
                        x:Key="ListViewItemBackgroundSelectedPressed"
                        ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource
                        x:Key="ListViewItemForegroundSelected"
                        ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalTrackDisplayItem">
                        <Grid
                            Padding="6"
                            Tag="{x:Bind Index}"
                            Tapped="LocalTrackRow_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Glyph="&#xE768;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind DisplayTitle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
